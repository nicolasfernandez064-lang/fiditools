# Client ID público de la aplicación creada en Mercado Libre Developers
MELI_CLIENT_ID=8448527772198012

# Cargar únicamente en Vercel o en .env.local. No subir a GitHub.
MELI_CLIENT_SECRET=

# Debe coincidir exactamente con la Redirect URI configurada en Mercado Libre Developers.
MELI_REDIRECT_URI=http://localhost:3000/api/auth/mercadolibre/callback

# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
